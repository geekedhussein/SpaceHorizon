{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenarios.schema.json",
  "title": "Mission scenarios",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "allOf": [
      { "$ref": "common.schema.json#/$defs/sourced" },
      {
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "mission_type": { "enum": ["earth-observation"] },
          "objective_id": {
            "description": "Links the scenario to instruments through their compatible_objectives.",
            "$ref": "common.schema.json#/$defs/id"
          },
          "summary": { "$ref": "common.schema.json#/$defs/text" },
          "objective": { "$ref": "common.schema.json#/$defs/text" },
          "budget_musd": {
            "description": "Money available for the whole mission, in millions of US dollars. A game-design value.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "planned_lifetime_years": {
            "description": "How long the mission is meant to run. A game-design value.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "requirements": {
            "description": "Measurable requirements generated by the objective. Each one is checked by the simulation.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": { "$ref": "common.schema.json#/$defs/id" },
                "label": { "$ref": "common.schema.json#/$defs/text" },
                "metric": {
                  "description": "The simulation result this requirement is checked against.",
                  "enum": [
                    "revisit_days",
                    "ground_resolution_m",
                    "data_returned_gb_per_month",
                    "lifetime_years"
                  ]
                },
                "comparator": { "enum": ["<=", ">="] },
                "threshold": { "type": "number" },
                "unit": { "type": "string", "minLength": 1 },
                "why_it_matters": { "$ref": "common.schema.json#/$defs/text" }
              },
              "required": [
                "id",
                "label",
                "metric",
                "comparator",
                "threshold",
                "unit",
                "why_it_matters"
              ],
              "additionalProperties": false
            }
          },
          "real_mission_name": { "type": "string", "minLength": 1 },
          "real_mission_fact": { "$ref": "common.schema.json#/$defs/text" },
          "real_mission_source": { "type": "string", "minLength": 1 }
        },
        "required": [
          "id",
          "name",
          "mission_type",
          "objective_id",
          "summary",
          "objective",
          "budget_musd",
          "planned_lifetime_years",
          "requirements",
          "real_mission_name",
          "real_mission_fact",
          "real_mission_source"
        ]
      }
    ],
    "unevaluatedProperties": false
  }
}
