{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components.schema.json",
  "title": "Spacecraft components (everything except instruments)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "allOf": [
      { "$ref": "common.schema.json#/$defs/sourced" },
      {
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "$ref": "common.schema.json#/$defs/text" },
          "manufacturer": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "structure",
              "solar_array",
              "battery",
              "communications",
              "computer",
              "attitude_control",
              "thermal",
              "propulsion"
            ]
          },
          "mass_kg": { "type": "number", "minimum": 0 },
          "power_w": {
            "description": "Power while working. Negative draws power, positive generates it. For solar arrays: peak output in sunlight when new.",
            "type": "number"
          },
          "standby_power_w": {
            "description": "Power draw while switched on but idle. Negative or zero.",
            "type": "number",
            "maximum": 0
          },
          "cost_musd": {
            "description": "Price in millions of US dollars.",
            "type": "number",
            "minimum": 0
          },
          "price_source": {
            "description": "Where the price comes from, if different from source.",
            "type": "string",
            "minLength": 1
          },
          "tier": { "enum": ["simple", "advanced"] },
          "description": { "$ref": "common.schema.json#/$defs/text" },
          "why_it_matters": { "$ref": "common.schema.json#/$defs/text" },
          "form_factor_u": {
            "description": "Structures: size of the CubeSat frame in units (1U is a 10 cm cube).",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "body_size_mm": {
            "description": "Structures: outside size of the whole spacecraft body in millimetres, as three numbers.",
            "type": "array",
            "items": { "type": "number", "exclusiveMinimum": 0 },
            "minItems": 3,
            "maxItems": 3
          },
          "max_mass_kg": {
            "description": "Structures: the most the whole spacecraft may weigh in this frame size.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size_source": {
            "description": "Structures: where body_size_mm and max_mass_kg come from.",
            "type": "string",
            "minLength": 1
          },
          "deployed_area_m2": {
            "description": "Solar arrays: area of the panels that unfold away from the body. Leave out for panels fixed to the body.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fits_form_factors_u": {
            "description": "Frame sizes this part is made for. Leave out if it fits any frame.",
            "type": "array",
            "items": { "type": "number", "exclusiveMinimum": 0 },
            "minItems": 1,
            "uniqueItems": true
          },
          "capacity_wh": {
            "description": "Batteries: stored energy in watt-hours.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_data_rate_mbps": {
            "description": "Radios: highest downlink data rate in megabits per second.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "frequency_mhz": {
            "description": "Radios: centre of the downlink band in megahertz.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rf_power_w": {
            "description": "Radios: radio power sent to the antenna in watts.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "two_way": {
            "description": "Radios: true if the radio can also receive commands from the ground.",
            "type": "boolean"
          },
          "antenna_name": {
            "description": "Radios: the antenna the radio is paired with.",
            "type": "string",
            "minLength": 1
          },
          "antenna_gain_dbi": {
            "description": "Radios: how strongly the antenna focuses the signal, in dBi.",
            "type": "number"
          },
          "antenna_mass_kg": {
            "description": "Radios: mass of the antenna. Not included in mass_kg.",
            "type": "number",
            "minimum": 0
          },
          "antenna_source": {
            "description": "Radios: where the antenna figures come from.",
            "type": "string",
            "minLength": 1
          },
          "storage_gb": {
            "description": "Computers: data storage in gigabytes.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pointing_accuracy_deg": {
            "description": "Attitude control: how closely it can hold a direction, in degrees.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "propellant_kg": {
            "description": "Propulsion: propellant carried. Already included in mass_kg.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "isp_s": {
            "description": "Propulsion: specific impulse in seconds.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "thrust_mn": {
            "description": "Propulsion: thrust in millinewtons.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "total_impulse_ns": {
            "description": "Propulsion: total impulse in newton-seconds.",
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "name",
          "manufacturer",
          "category",
          "mass_kg",
          "power_w",
          "cost_musd",
          "tier",
          "description",
          "why_it_matters"
        ]
      },
      {
        "if": { "properties": { "category": { "const": "structure" } } },
        "then": { "required": ["form_factor_u", "body_size_mm", "max_mass_kg", "size_source"] }
      },
      {
        "if": { "properties": { "category": { "const": "solar_array" } } },
        "then": { "properties": { "power_w": { "exclusiveMinimum": 0 } } },
        "else": { "properties": { "power_w": { "maximum": 0 } } }
      },
      {
        "if": { "properties": { "category": { "const": "battery" } } },
        "then": { "required": ["capacity_wh"] }
      },
      {
        "if": { "properties": { "category": { "const": "communications" } } },
        "then": {
          "required": [
            "max_data_rate_mbps",
            "frequency_mhz",
            "rf_power_w",
            "two_way",
            "antenna_name",
            "antenna_gain_dbi",
            "antenna_mass_kg",
            "antenna_source"
          ]
        }
      },
      {
        "if": { "properties": { "category": { "const": "propulsion" } } },
        "then": { "required": ["propellant_kg", "isp_s", "thrust_mn"] }
      },
      {
        "if": { "properties": { "category": { "const": "computer" } } },
        "then": { "required": ["storage_gb"] }
      }
    ],
    "unevaluatedProperties": false
  }
}
